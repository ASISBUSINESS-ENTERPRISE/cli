--- timestamp_metadata.py ----
------------------------------
import subprocess
import os

filename = "IGAPS_Archive_Metadata.json"

# Check if the file exists
if not os.path.exists(filename):
    print(f"Error: {filename} not found.")
    exit(1)

# Step 1: Stamp the file
print("Stamping...")
subprocess.run(["ots", "stamp", filename])

# Step 2: Verify the timestamp
print("Verifying (this may not be confirmed yet)...")
subprocess.run(["ots", "verify", f"{filename}.ots"])